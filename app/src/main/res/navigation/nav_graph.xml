<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.todaynews.presentation.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_articleDetailActivity"
            app:destination="@id/articleDetailActivity" />
    </fragment>
    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.example.todaynews.presentation.favorite.FavoriteFragment"
        android:label="Favorite"
        tools:layout="@layout/fragment_favorite" >
        <action
            android:id="@+id/action_favoriteFragment_to_articleDetailActivity"
            app:destination="@id/articleDetailActivity" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.todaynews.presentation.search.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />
    <activity
        android:id="@+id/articleDetailActivity"
        android:name="com.example.todaynews.presentation.detail.ArticleDetailActivity"
        android:label="activity_article_detail"
        tools:layout="@layout/activity_article_detail" />
</navigation>